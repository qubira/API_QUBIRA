# ============================================================
# QUBIRA API — Variables de entorno
# Copia este archivo como .env y completa los valores
# ============================================================

# Neon PostgreSQL — la MISMA base de datos que usa QUBIRA
DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require

# JWT — DEBE ser exactamente el mismo valor que JWT_SECRET en QUBIRA/.env
# (los tokens tienen que ser válidos en ambos servicios durante la transición)
JWT_SECRET=cambia-esto-por-una-clave-secreta-larga-y-aleatoria-32chars
JWT_EXPIRES_IN=24h

# Contraseña maestra del panel de Soporte (mismo valor que MASTER_PASSWORD en QUBIRA/.env)
MASTER_PASSWORD=QUBIRA2024

# Orígenes permitidos por CORS — todos los paneles que van a llamar a esta API,
# separados por coma. En desarrollo se permite todo.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://qubira.onrender.com

# Cloudinary — almacenamiento de fotos de empleados (RRHH)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# Puerto del servidor (Render lo asigna automáticamente con PORT)
PORT=4000

# Entorno: development | production
NODE_ENV=development
